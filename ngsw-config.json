{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "navigationUrls": [
    "/**",
    "!/**/*.*",
    "!/**/*__*",
    "!/**/*__*/**"
  ],
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "fonts-icons",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(otf|ttf|woff|woff2|eot)"
        ]
      }
    },
    {
      "name": "images",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**",
          "/demo/**",
          "/media/**",
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|ico)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "operator-api",
      "urls": [
        "https://jxz59jh15f.execute-api.us-east-1.amazonaws.com/operator/**"
      ],
      "cacheConfig": {
        "maxSize": 1,
        "maxAge": "0s",
        "timeout": "30s",
        "strategy": "freshness"
      }
    },
    {
      "name": "api-reads",
      "urls": [
        "https://jxz59jh15f.execute-api.us-east-1.amazonaws.com/**"
      ],
      "cacheConfig": {
        "maxSize": 500,
        "maxAge": "1d",
        "timeout": "30s",
        "strategy": "freshness"
      }
    }
  ]
}
